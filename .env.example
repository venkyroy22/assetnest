# ── DATABASE & AUTH ──────────────────────────────────────────────────────────
# Prisma / Postgres connection string (Required for Login/Sign-up)
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# NextAuth Secret (Random string for session encryption)
AUTH_SECRET="your-random-secret-here"

# NextAuth URL (Only needed for local dev)
NEXTAUTH_URL="http://localhost:3000"

# ── THIRD PARTY SERVICES ─────────────────────────────────────────────────────
# Supabase (Required for Prompt Likes)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Cloudinary (Required for dynamic asset hosting)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ── OAUTH PROVIDERS ──────────────────────────────────────────────────────────
AUTH_GITHUB_ID="your-github-id"
AUTH_GITHUB_SECRET="your-github-secret"
AUTH_GOOGLE_ID="your-google-id"
AUTH_GOOGLE_SECRET="your-google-secret"

# ── STREAMLET ────────────────────────────────────────────────────────────────
STREAMLET_API_KEY="your-streamlet-api-key-here"
STREAMLET_ACCOUNT_NUMBER="your-streamlet-account-number-here"
